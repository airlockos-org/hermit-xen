 pub trait XenHvmOp: XenHypercall {
+    fn set_hvm_param(&self, index: u32, value: u64) -> Result<(), XenError> {
+        let param = xen_hvm_param {
+            domid: DomId::SELF.0,
+            index,
+            pad: 0,
+            value,
+        };
+        let buffer = self.make_const_object(&param)?;
+        unsafe {
+            self.hypercall2(
+                __HYPERVISOR_hvm_op as _,
